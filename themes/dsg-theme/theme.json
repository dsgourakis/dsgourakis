{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f4f6fb" },
				{ "slug": "contrast", "name": "Contrast", "color": "#14182b" },
				{ "slug": "muted", "name": "Muted text", "color": "#4a5068" },
				{ "slug": "accent", "name": "Accent", "color": "#1d3875" },
				{ "slug": "accent-soft", "name": "Accent soft", "color": "#e3e9f6" },
				{ "slug": "border", "name": "Border", "color": "#d4d9e6" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.25rem", "fluid": { "min": "2.25rem", "max": "3.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "0.75rem" },
				{ "slug": "40", "name": "M", "size": "1.25rem" },
				{ "slug": "50", "name": "L", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 7vw, 5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"typography": { "textDecoration": "none" }
				}
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "8px" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontWeight": "700", "fontSize": "var(--wp--preset--font-size--large)" },
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" }
					}
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
