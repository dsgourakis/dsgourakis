{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "dsg/project-grid",
	"version": "0.1.0",
	"title": "Project Grid",
	"category": "design",
	"icon": "screenoptions",
	"description": "Shows your Projects automatically as Project Cards: the first one featured across the full row, the rest in two columns. Sorted by each Project's Order field, then newest first.",
	"keywords": [ "portfolio", "projects", "work", "grid", "query" ],
	"textdomain": "dsg-core",
	"attributes": {
		"align": {
			"type": "string",
			"default": "wide"
		},
		"numberOfItems": {
			"type": "number",
			"default": 3
		},
		"technology": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": [ "top", "bottom" ]
		}
	},
	"render": "file:./render.php",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
